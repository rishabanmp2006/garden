# Supabase Project Credentials (required for multi-user deployment)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend FastAPI URL
VITE_API_URL=http://localhost:8000/api

# Local LLM Gateway (Ollama)
VITE_LOCAL_LLM_BASE_URL=http://localhost:11434
VITE_LOCAL_LLM_MODEL=llama3
